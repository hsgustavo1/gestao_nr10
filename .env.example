# ============================================================================
# Variáveis de ambiente — APP (TanStack Start). Copie para .env e preencha.
# NÃO faça commit do .env real (já está no .gitignore).
# ============================================================================

# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Chave pública (publishable / anon) — segura para o client
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Apenas servidor (SSR / server functions). NUNCA expor ao client. ---
# Mesma URL acima (sem prefixo VITE) para uso no servidor
SUPABASE_URL=
# Mesma chave pública acima para uso no servidor
SUPABASE_PUBLISHABLE_KEY=
# Chave service-role (ignora RLS) — usada só em client.server.ts / edge functions
SUPABASE_SERVICE_ROLE_KEY=
